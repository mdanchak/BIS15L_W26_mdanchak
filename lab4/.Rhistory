mapping= aes(x=vore)) + geom_bar(mapping=aes(fill=species)))
ggplot(data=msleep,
mapping= aes(x=vore)) + geom_bar(mapping=aes(fill=species))
mapping= aes(x=vore)) + geom_bar(mapping=aes(fill=species)
