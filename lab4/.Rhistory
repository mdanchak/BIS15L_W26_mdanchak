``````colors()
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(na.rm = TRUE) +
geom_smooth(method = lm, se=TRUE) + colors()
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm, color=species)) + geom_point(na.rm = TRUE) +
geom_smooth(method = lm, se=TRUE)
This graph is fine, but it doesn't distinguish between species. It might be helpful for the reader to see how each species is represented. We can do this by mapping the color aesthetic to species.
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm, color=species)) + geom_point(na.rm = TRUE) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species))
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species, shape= species)) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species, shape= island)) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=bill_length_mm)) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE)
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Body Mass (g) vs Flipper Length (mm)")
ggplot(data=penguins,
mapping= aes(x=body_mass_g, y=flipper_length_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Body Mass (g) vs Flipper Length (mm)", x="Body Mass (g)", y= "Flipper Length (mm)")
ggplot(data=penguins,
mapping= aes(x=bill_length_mm, y=bill_depth_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Bill Length (mm) vs Bill Depth (mm))", x="Bill Length (mm)", y= "Bill Depth (mm)")
ggplot(data=penguins,
mapping= aes(x=bill_length_mm, y=bill_depth_mm)) + geom_boxplot(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Bill Length (mm) vs Bill Depth (mm))", x="Bill Length (mm)", y= "Bill Depth (mm)")
ggplot(data=penguins,
mapping= aes(x=bill_length_mm, y=bill_depth_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Bill Length (mm) vs Bill Depth (mm))", x="Bill Length (mm)", y= "Bill Depth (mm)")
ggplot(data=penguins,
mapping= aes(x=bill_length_mm, y=bill_depth_mm)) + geom_point(mapping=aes(color=species)) +
geom_smooth(method = lm, se=TRUE) + labs(title = "Bill Length (mm) vs Bill Depth (mm)", x="Bill Length (mm)", y= "Bill Depth (mm)")
